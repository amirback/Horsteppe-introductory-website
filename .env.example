# Переменные окружения. Задаются в Vercel → Project → Settings → Environment Variables.
# Файл .env в git не попадает никогда.

# --- обязательно на проде -------------------------------------------------
# Supabase проекта Horsteppe (тот же, что у продукта). Project Settings → Data API.
SUPABASE_URL=
# Служебный ключ: Project Settings → API Keys → service_role (или новый secret key sb_secret_…).
# Только на сервере, в браузер не попадает.
SUPABASE_SERVICE_ROLE_KEY=
# Пароль входа в админку /admin. Не короче 8 символов, лучше 12+.
# Смена пароля выключает все сессии и меняет ссылку для Google Таблицы.
ADMIN_PASSWORD=

# --- по желанию --------------------------------------------------------------
# Уведомления о новых заявках в Telegram (бот от @BotFather и id чата).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Свой домен, когда появится (иначе адрес берётся из Vercel сам).
NEXT_PUBLIC_SITE_URL=
# Адрес продукта для кнопки «Войти» (по умолчанию https://horsteppe.vercel.app).
NEXT_PUBLIC_APP_URL=
# Дополнительная соль подписи сессии админки.
ADMIN_SESSION_SECRET=

# --- только для разработки на своём компьютере ------------------------------
# Без ключей Supabase заявки пишутся в .data/ (на Vercel это запрещено кодом).
# LEADS_FILE_STORE=1
# LEADS_FILE_DIR=.data
